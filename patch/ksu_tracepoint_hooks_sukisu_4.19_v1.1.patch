diff --git a/fs/exec.c b/fs/exec.c
index 5f2af741d006..d788d267e230 100644
--- a/fs/exec.c
+++ b/fs/exec.c
@@ -75,6 +75,10 @@
 
 #include <trace/events/sched.h>
 
+#if defined(CONFIG_KSU) && defined(CONFIG_KSU_TRACEPOINT_HOOK)
+#include <../drivers/kernelsu/ksu_trace.h>
+#endif
+
